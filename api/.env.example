# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Shown in email subjects and the hosted auth-link pages (verify/unlock/reset).
APP_NAME=My App

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=app_admin
DB_PASSWORD=
DB_NAME=app_db

# The address a human clicks an emailed link to reach -- this PC's LAN address for local
# dev (match the app's API_BASE_URL), the real API domain once deployed.
PUBLIC_BASE_URL=http://localhost:3000

# Leave SMTP_* unset to use the dev-mode fallback (prints the link to the console instead
# of emailing it) -- the whole verify/unlock/reset flow is fully testable without this.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
